# Optional settings for `docker compose up --build`.
#
# Nothing here is required: every password and key is generated on the first start. To change one
# of these, copy this file to .env (next to docker-compose.yml; ignored by git) and uncomment the
# line — or set the variable in the shell you run compose from.

# --- AI analysis ----------------------------------------------------------------------------------

# Your Anthropic API key (https://console.anthropic.com → API keys). Without it the platform works,
# but every AI analysis is recorded as failed.
# ANTHROPIC_API_KEY=

# --- Where the console is reached -----------------------------------------------------------------

# The port the console, the API and OTLP log ingest listen on.
# IIM_PORT=8080

# The address people open the console at; invitation and password-reset links point here.
# IIM_PUBLIC_URL=http://localhost:8080

# Behind your own reverse proxy (TLS termination): its address or network, so the platform trusts
# the X-Forwarded-* headers it adds. Comma-separated, e.g. 10.0.0.5 or 10.0.0.0/24.
# FORWARDED_KNOWN_PROXIES=

# --- Email (invitations and password resets) ------------------------------------------------------

# Without a host, links are still shown to the Admin once, to pass on by hand.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- Data -----------------------------------------------------------------------------------------

# How many days of ingested log records are kept (minimum 1). Incidents and signals keep their own
# evidence summary, so they outlive the logs they were raised from.
# LOG_RETENTION_DAYS=7

# --- Admin interfaces (127.0.0.1 only) ------------------------------------------------------------

# SEQ_PORT=8081
# PGADMIN_PORT=5050
# KIBANA_PORT=5601
# PGADMIN_EMAIL=admin@example.com
