# IIM installation settings (Adım 26).
#
# Copy this file to deploy/.env and fill it in BEFORE the first `docker compose up`:
#
#   cp deploy/example.env deploy/.env
#
# deploy/.env is ignored by git — it holds your secrets; this file never should.
#
# Every REQUIRED value is empty on purpose: there is no default password anywhere in this
# repository, and compose refuses to start while one is missing. Generate each secret with:
#
#   openssl rand -hex 32
#
# (hex rather than base64: the passwords end up inside connection strings, where only letters and
# digits are safe without quoting.)
#
# Postgres, RabbitMQ and the signing key are read when their volume or the services start. Changing
# a database password after the first start also needs the same change inside Postgres (see
# deploy/postgres/init.sh).

# --- Required -----------------------------------------------------------------------------------

# Postgres superuser (user "postgres"). Used by pgAdmin and by the first-start script only.
POSTGRES_PASSWORD=

# One database user per service; each can reach only its own database.
IDENTITY_DB_PASSWORD=
INCIDENT_DB_PASSWORD=
AGENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
TELEMETRY_DB_PASSWORD=

# RabbitMQ, the services' message bus (user "iim"). Never published outside Docker.
RABBITMQ_PASSWORD=

# Signs every session token. At least 32 characters. Changing it signs everybody out.
JWT_SIGNING_KEY=

# Seq, IIM's own logs and traces (user "admin"). The first-run setup code is logged there too.
SEQ_ADMIN_PASSWORD=

# pgAdmin sign-in. The email must look like a real address (pgAdmin rejects e.g. admin@localhost).
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --- AI analysis --------------------------------------------------------------------------------

# Anthropic API key for the incident analysis. Without it everything else works and each analysis
# is marked failed on its incident.
ANTHROPIC_API_KEY=

# --- Where IIM is reached -----------------------------------------------------------------------

# The address people open in the browser. Used in invitation and password-reset links.
IIM_PUBLIC_URL=http://localhost:8080

# The host port of the console and the API — the only port open to the network.
IIM_PORT=8080

# Behind your own HTTPS proxy: the proxy's address or network (comma-separated, e.g.
# 172.16.0.0/12 for a proxy on the Docker host). Only these are believed about the caller's
# address and scheme. Leave empty when nothing is in front of IIM.
FORWARDED_KNOWN_PROXIES=

# --- Admin interfaces (reachable from this machine only: 127.0.0.1) -----------------------------

SEQ_PORT=8081
PGADMIN_PORT=5050
KIBANA_PORT=5601

# --- Email for invitations and password resets --------------------------------------------------

# Any SMTP server: your company's, Google Workspace, Microsoft 365, Amazon SES, SendGrid, Mailgun...
# Left empty, invitations are still created and their link is shown to the Admin to pass on.
# (Incident notification emails are separate: each organisation enters its own SMTP server in the
# console, under Settings -> Integrations -> Notifications.)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
