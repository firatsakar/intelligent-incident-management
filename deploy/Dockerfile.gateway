# syntax=docker/dockerfile:1

# The gateway and the console it serves (Adım 26): one image, one port, one origin — which is what
# lets the session cookies be SameSite=Strict. Built from the repository root:
#
#   docker build -f deploy/Dockerfile.gateway .

# The console, built the same way `npm run build` builds it on a developer's machine.
FROM node:24-bookworm-slim AS console
WORKDIR /web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo

COPY src/ src/

RUN --mount=type=cache,id=iim-nuget,target=/root/.nuget/packages \
    dotnet publish src/Gateway/Gateway.API/Gateway.API.csproj -c Release -o /app -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app

COPY --from=build /app .
COPY --from=console /web/dist ./console

# Spa:Root is what turns the gateway from an API router into the console's host as well
# (SpaHosting); without it the same image would answer /api and nothing else.
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS=8080 \
    Spa__Root=/app/console

EXPOSE 8080

USER $APP_UID

ENTRYPOINT ["dotnet", "Gateway.API.dll"]
