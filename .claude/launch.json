{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "gateway",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Gateway/Gateway.API",
        "--launch-profile",
        "http"
      ],
      "port": 5100
    },
    {
      "name": "identity",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Services/IdentityService/IdentityService.API",
        "--launch-profile",
        "http"
      ],
      "port": 5240
    }
  ]
}
